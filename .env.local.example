# Copy to .env.local and fill in values

# Email capture (add your provider of choice — Resend, Mailchimp, ConvertKit, etc.)
WAITLIST_API_KEY=

# Stripe (for future payment integration)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Auth — Google is required; Apple/email can be enabled when configured
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
NEXT_PUBLIC_APPLE_SIGNIN_ENABLED=
RESEND_API_KEY=
EMAIL_FROM=
# Optional operator recipient for cron delivery failures; unset logs only.
ALERT_EMAIL=
NEXT_PUBLIC_EMAIL_SIGNIN_ENABLED=

# Vercel Blob — for storing uploaded certificate files
# Get this from Vercel dashboard → Storage → Blob → your store → .env.local button
BLOB_READ_WRITE_TOKEN=

# Vercel Cron — renewal reminder push notifications
# Generate with: openssl rand -hex 32
# Add this to Vercel environment variables too (Settings → Environment Variables)
CRON_SECRET=your-secret-here

# Optional native Google iOS OAuth client ID, accepted alongside GOOGLE_CLIENT_ID.
GOOGLE_IOS_CLIENT_ID=
# Required native Apple bundle identifier (replaces APPLE_IOS_BUNDLE_ID/default fallback).
APPLE_BUNDLE_ID=

# PostHog product analytics + session recordings (public project key, starts phc_).
# Set in Vercel for Production only; leave empty locally so dev sends nothing.
NEXT_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com (US cloud) or https://eu.i.posthog.com (EU cloud)
NEXT_PUBLIC_POSTHOG_HOST=
