# Copy to .env.local and fill in values

# Email capture (add your provider of choice — Resend, Mailchimp, ConvertKit, etc.)
WAITLIST_API_KEY=

# Stripe (for future payment integration)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Auth — Google is required; Apple/email can be enabled when configured
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Optional operator recipient for cron delivery failures; unset logs only.
ALERT_EMAIL=

# Vercel Blob — for storing uploaded certificate files
# Get this from Vercel dashboard → Storage → Blob → your store → .env.local button
BLOB_READ_WRITE_TOKEN=

# Vercel Cron — renewal reminder push notifications
# Generate with: openssl rand -hex 32
# Add this to Vercel environment variables too (Settings → Environment Variables)
CRON_SECRET=your-secret-here

# Optional native Google iOS OAuth client ID, accepted alongside GOOGLE_CLIENT_ID.
GOOGLE_IOS_CLIENT_ID=
# Required native Apple bundle identifier (replaces APPLE_IOS_BUNDLE_ID/default fallback).
APPLE_BUNDLE_ID=

# PostHog product analytics + session recordings (public project key, starts phc_).
# Set in Vercel for Production only; leave empty locally so dev sends nothing.
NEXT_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com (US cloud) or https://eu.i.posthog.com (EU cloud)
NEXT_PUBLIC_POSTHOG_HOST=

# Optional consented Google Ads registration imports (server only).
# Disabled until the migration, import conversion action and API access are ready.
# See docs/google-ads-registration.md. Never reuse the website tag's label here.
GOOGLE_ADS_MEASUREMENT_ENABLED=false
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_REGISTRATION_ACTION_ID=
# Optional manager account, 10 digits without hyphens; blank = direct access.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Generate a separate 32-byte key with: openssl rand -hex 32
GOOGLE_ADS_COOKIE_KEY=
# Authorize an operator account with https://www.googleapis.com/auth/datamanager.
# These are separate from end-user Google Sign-In credentials above.
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_OAUTH_REFRESH_TOKEN=
